(Image IN ("*\\powershell.exe", "*\\pwsh.exe") OR OriginalFileName IN ("PowerShell.EXE", "pwsh.dll")) (ScriptBlockText IN ("*Add-Persistence*", "*Find-AVSignature*", "*Get-GPPAutologon*", "*Get-GPPPassword*", "*Get-HttpStatus*", "*Get-Keystrokes*", "*Get-SecurityPackages*", "*Get-TimedScreenshot*", "*Get-VaultCredential*", "*Get-VolumeShadowCopy*", "*Install-SSP*", "*Invoke-CredentialInjection*", "*Invoke-DllInjection*", "*Invoke-Mimikatz*", "*Invoke-NinjaCopy*", "*Invoke-Portscan*", "*Invoke-ReflectivePEInjection*", "*Invoke-ReverseDnsLookup*", "*Invoke-Shellcode*", "*Invoke-TokenManipulation*", "*Invoke-WmiCommand*", "*Mount-VolumeShadowCopy*", "*New-ElevatedPersistenceOption*", "*New-UserPersistenceOption*", "*New-VolumeShadowCopy*", "*Out-CompressedDll*", "*Out-EncodedCommand*", "*Out-EncryptedScript*", "*Out-Minidump*", "*PowerUp*", "*PowerView*", "*Remove-Comments*", "*Remove-VolumeShadowCopy*", "*Set-CriticalProcess*", "*Set-MasterBootRecord*"))

(Image IN ("*\\powershell.exe", "*\\pwsh.exe") OR OriginalFileName IN ("PowerShell.EXE", "pwsh.dll")) (CommandLine="* -e *" OR CommandLine="* /e *" OR CommandLine="* –e *" OR CommandLine="* —e *" OR CommandLine="* ―e *" OR CommandLine="* -en *" OR CommandLine="* /en *" OR CommandLine="* –en *" OR CommandLine="* —en *" OR CommandLine="* ―en *" OR CommandLine="* -enc *" OR CommandLine="* /enc *" OR CommandLine="* –enc *" OR CommandLine="* —enc *" OR CommandLine="* ―enc *" OR CommandLine="* -enco*" OR CommandLine="* /enco*" OR CommandLine="* –enco*" OR CommandLine="* —enco*" OR CommandLine="* ―enco*" OR CommandLine="* -ec *" OR CommandLine="* /ec *" OR CommandLine="* –ec *" OR CommandLine="* —ec *" OR CommandLine="* ―ec *" OR ((CommandLine IN ("*DownloadString*", "*DownloadData*", "*Net.WebClient*", "*Invoke-WebRequest*", "*iwr *")) (CommandLine IN ("*IEX*", "*Invoke-Expression*"))))

