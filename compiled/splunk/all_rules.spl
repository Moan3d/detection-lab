source="WinEventLog:Microsoft-Windows-Sysmon/Operational" EventCode=1 (Image IN ("*\\powershell.exe", "*\\pwsh.exe")) (CommandLine IN ("*Register-ScheduledTask*", "*New-ScheduledTaskAction*", "*PS_ScheduledTask*", "*Invoke-CimMethod*", "*New-ScheduledTaskAction*"))

source="WinEventLog:Microsoft-Windows-Sysmon/Operational" EventCode=1 Image="*\\at.exe"

source="WinEventLog:Microsoft-Windows-Sysmon/Operational" EventCode=1 Image="*\\rundll32.exe" CommandLine="*comsvcs.dll*" CommandLine="*MiniDump*"

(Image IN ("*\\powershell.exe", "*\\pwsh.exe") OR OriginalFileName IN ("PowerShell.EXE", "pwsh.dll")) (ScriptBlockText IN ("*Add-Persistence*", "*Find-AVSignature*", "*Get-GPPAutologon*", "*Get-GPPPassword*", "*Get-HttpStatus*", "*Get-Keystrokes*", "*Get-SecurityPackages*", "*Get-TimedScreenshot*", "*Get-VaultCredential*", "*Get-VolumeShadowCopy*", "*Install-SSP*", "*Invoke-CredentialInjection*", "*Invoke-DllInjection*", "*Invoke-Mimikatz*", "*Invoke-NinjaCopy*", "*Invoke-Portscan*", "*Invoke-ReflectivePEInjection*", "*Invoke-ReverseDnsLookup*", "*Invoke-Shellcode*", "*Invoke-TokenManipulation*", "*Invoke-WmiCommand*", "*Mount-VolumeShadowCopy*", "*New-ElevatedPersistenceOption*", "*New-UserPersistenceOption*", "*New-VolumeShadowCopy*", "*Out-CompressedDll*", "*Out-EncodedCommand*", "*Out-EncryptedScript*", "*Out-Minidump*", "*PowerUp*", "*PowerView*", "*Remove-Comments*", "*Remove-VolumeShadowCopy*", "*Set-CriticalProcess*", "*Set-MasterBootRecord*"))

source="WinEventLog:Microsoft-Windows-Sysmon/Operational" EventCode=1 (Image IN ("*\\powershell.exe", "*\\pwsh.exe") OR OriginalFileName IN ("PowerShell.EXE", "pwsh.dll")) (CommandLine="* -e *" OR CommandLine="* /e *" OR CommandLine="* –e *" OR CommandLine="* —e *" OR CommandLine="* ―e *" OR CommandLine="* -en *" OR CommandLine="* /en *" OR CommandLine="* –en *" OR CommandLine="* —en *" OR CommandLine="* ―en *" OR CommandLine="* -enc *" OR CommandLine="* /enc *" OR CommandLine="* –enc *" OR CommandLine="* —enc *" OR CommandLine="* ―enc *" OR CommandLine="* -enco*" OR CommandLine="* /enco*" OR CommandLine="* –enco*" OR CommandLine="* —enco*" OR CommandLine="* ―enco*" OR CommandLine="* -ec *" OR CommandLine="* /ec *" OR CommandLine="* –ec *" OR CommandLine="* —ec *" OR CommandLine="* ―ec *" OR ((CommandLine IN ("*DownloadString*", "*DownloadData*", "*Net.WebClient*", "*Invoke-WebRequest*", "*iwr *")) (CommandLine IN ("*IEX*", "*Invoke-Expression*"))))

source="WinEventLog:Microsoft-Windows-Sysmon/Operational" EventCode=1 (Image="*\\bitsadmin.exe" OR OriginalFileName="bitsadmin.exe") (CommandLine="*-transfer*" OR CommandLine="*/transfer*" OR CommandLine="*–transfer*" OR CommandLine="*—transfer*" OR CommandLine="*―transfer*" OR CommandLine="*-addfile*" OR CommandLine="*/addfile*" OR CommandLine="*–addfile*" OR CommandLine="*—addfile*" OR CommandLine="*―addfile*")

source="WinEventLog:Microsoft-Windows-Sysmon/Operational" EventCode=11 TargetFilename="*\\Windows\\System32\\Tasks\\*" NOT (Image IN ("*\\svchost.exe", "*\\msiexec.exe", "*\\setup.exe", "*\\GoogleUpdate.exe", "*\\OneDriveStandaloneUpdater.exe"))

EventCode=4720 SamAccountName="*$"

source="WinEventLog:Microsoft-Windows-Sysmon/Operational" EventCode=1 (Image IN ("*\\powershell.exe", "*\\pwsh.exe") OR OriginalFileName IN ("PowerShell.EXE", "pwsh.dll")) (CommandLine IN ("*New-Object Net.WebClient*", "*Invoke-WebRequest*", "*DownloadFile*", "*client.GetAsync*", "* iwr *", "*WriteAllBytes*")) (CommandLine IN ("*http://*", "*https://*", "*ftp://*"))

| multisearch
[ search source="WinEventLog:Microsoft-Windows-Sysmon/Operational" EventCode=1 (Image="*\\certutil.exe" OR OriginalFileName="CertUtil.exe") (CommandLine="*-urlcache*" OR CommandLine="*/urlcache*" OR CommandLine="*–urlcache*" OR CommandLine="*—urlcache*" OR CommandLine="*―urlcache*" OR CommandLine="*-split*" OR CommandLine="*/split*" OR CommandLine="*–split*" OR CommandLine="*—split*" OR CommandLine="*―split*" OR CommandLine="*-verifyctl*" OR CommandLine="*/verifyctl*" OR CommandLine="*–verifyctl*" OR CommandLine="*—verifyctl*" OR CommandLine="*―verifyctl*") | eval event_type="certutil_proc" ]
[ search Image="*\\certutil.exe" | eval event_type="certutil_file" ]

| bin _time span=10s
| stats dc(event_type) as event_type_count earliest(eval(if(event_type="certutil_proc",_time,null()))) as first_certutil_proc earliest(eval(if(event_type="certutil_file",_time,null()))) as first_certutil_file by _time Computer ProcessId

| search event_type_count >= 2
| where first_certutil_proc < first_certutil_file

source="WinEventLog:Microsoft-Windows-Sysmon/Operational" (EventCode IN (12, 13, 14)) ((EventCode=13 TargetObject="*\\Schedule\\TaskCache\\Tree\\*" (TargetObject IN ("*\\Index", "*\\SD"))) OR (EventCode=12 TargetObject="*\\Schedule\\TaskCache\\Tree\\*" (TargetObject IN ("*\\Index", "*\\SD")))) NOT Image="*\\svchost.exe"

source="WinEventLog:Microsoft-Windows-Sysmon/Operational" (EventCode IN (12, 13, 14)) ((EventCode=13 TargetObject="*HKLM\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\Winlogon\\SpecialAccounts\\UserList*" Details="*DWORD (0x00000000)*") OR (EventCode=12 TargetObject="*HKLM\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\Winlogon\\SpecialAccounts\\UserList*"))

source="WinEventLog:Microsoft-Windows-Sysmon/Operational" EventCode=1 ((Image="*\\reg.exe" CommandLine="*Schedule\\TaskCache\\Tree*" CommandLine="*Index*" CommandLine="*0x0*") OR (Image="*\\reg.exe" CommandLine="*Schedule\\TaskCache\\Tree*" CommandLine="*delete*" CommandLine="*SD*"))

source="WinEventLog:Microsoft-Windows-Sysmon/Operational" EventCode=10 ((TargetImage="*\\lsass.exe" (GrantedAccess IN ("0x1010", "0x1410", "0x1418", "0x143a", "0x1438", "0x1f0fff", "0x1f1fff", "0x1f3fff"))) OR (TargetImage="*\\lsass.exe" (SourceImage IN ("*\\powershell.exe", "*\\mimikatz.exe", "*\\procdump.exe", "*\\procdump64.exe", "*\\sqldumper.exe", "*\\wce.exe", "*\\wce64.exe", "*\\wce32.exe")))) NOT (SourceImage IN ("C:\\Windows\\System32\\wininit.exe", "C:\\Windows\\System32\\csrss.exe", "C:\\Windows\\System32\\lsm.exe", "C:\\Windows\\System32\\wbem\\WmiPrvSE.exe", "C:\\Windows\\System32\\MRT.exe") OR (SourceImage="C:\\ProgramData\\Microsoft\\Windows Defender\\Platform\\*" SourceImage="*\\MsMpEng.exe"))

source="WinEventLog:Microsoft-Windows-Sysmon/Operational" EventCode=1 (((ParentImage IN ("*powershell.exe", "*cmd.exe", "*wscript.exe", "*mshta.exe")) (Image IN ("*net.exe", "*net1.exe")) (CommandLine IN ("*/add*", "*net user*", "*localgroup*", "* $*"))) OR (Image="*powershell.exe" (CommandLine IN ("*New-LocalUser*", "*Add-LocalGroupMember*", "* $*"))))

source="WinEventLog:Microsoft-Windows-Sysmon/Operational" EventCode=1 Image="*\\schtasks.exe" (CommandLine IN ("*/create*", "*-create*")) (CommandLine IN ("*http://*", "*https://*") OR CommandLine IN ("*\\Users\\*", "*\\Temp\\*", "*\\AppData\\*", "*\\ProgramData\\*", "*\\Public\\*") OR CommandLine IN ("*FromBase64String*", "*ExecutionPolicy Bypass*", "*cmd.exe*", "*powershell.exe*", "*regsvr32.exe*", "*rundll32.exe*", "*mshta.exe*"))
