(Image IN ("*\\powershell.exe", "*\\pwsh.exe")) (CommandLine IN ("*Register-ScheduledTask*", "*New-ScheduledTaskAction*", "*PS_ScheduledTask*", "*Invoke-CimMethod*", "*New-ScheduledTaskAction*"))

Image="*\\at.exe"

